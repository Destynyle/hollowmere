# Copy to .env (never committed) and fill in. docker compose reads it.

# Public hostname, once the tunnel serves it (WebSocket origin check).
TAP_ORIGINS=hollowmere.example.org
# Behind the tunnel: trust CF-Connecting-IP, and keep 8080 off the network.
TAP_TRUST_PROXY=1
HTTP_BIND=127.0.0.1
# Terminal client over raw TCP: 0.0.0.0 to open it (forward 4243 on the
# router), 127.0.0.1 to keep it for this machine.
TCP_BIND=0.0.0.0

TAP_LOG_LEVEL=info

# /metrics token, shared with Prometheus:
#   openssl rand -hex 24 > state/metrics_token && chmod 600 state/metrics_token
TAP_METRICS_TOKEN_FILE=/data/metrics_token

# From the Cloudflare dashboard (Zero Trust > Networks > Tunnels > your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=

# Grafana admin password (Grafana is bound to 127.0.0.1 only).
GRAFANA_ADMIN_PASSWORD=
