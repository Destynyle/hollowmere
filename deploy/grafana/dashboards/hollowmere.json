{
  "uid": "hollowmere",
  "title": "Hollowmere",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "hollowmere"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Players online",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tap_players_online",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open connections",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tap_connections_open",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tap_uptime_seconds",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Server up",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"hollowmere\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Players and connections",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tap_players_online",
          "legendFormat": "players"
        },
        {
          "refId": "B",
          "expr": "tap_connections_open",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Commands and errors per second",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tap_commands_total[5m])",
          "legendFormat": "commands"
        },
        {
          "refId": "B",
          "expr": "rate(tap_errors_total[5m])",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Abuse (per minute)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tap_abuse_command_flood_total[5m])*60",
          "legendFormat": "flood"
        },
        {
          "refId": "B",
          "expr": "rate(tap_abuse_rapid_connections_total[5m])*60",
          "legendFormat": "rapid connections"
        },
        {
          "refId": "C",
          "expr": "rate(tap_abuse_line_too_long_total[5m])*60",
          "legendFormat": "line too long"
        },
        {
          "refId": "D",
          "expr": "rate(tap_connections_rejected_total[5m])*60",
          "legendFormat": "rejected"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Traffic (lines per second)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tap_lines_received_total[5m])",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "rate(tap_lines_sent_total[5m])",
          "legendFormat": "sent"
        },
        {
          "refId": "C",
          "expr": "increase(tap_slow_clients_total[5m])",
          "legendFormat": "slow clients dropped (5m)"
        }
      ]
    }
  ]
}
